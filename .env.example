# ── คัดลอกเป็น .env.local แล้วใส่ค่าจริง ──

# LIFF ID จาก LINE Developers Console
# Channel ที่สร้าง LIFF app: ดูที่ tab "LIFF" → copy LIFF ID
VITE_LIFF_ID=1234567890-abcdefgh

# Apps Script Web App URL (ตัวที่ใช้กับ LINE webhook อยู่แล้ว)
VITE_API_URL=https://script.google.com/macros/s/AKfycb.../exec
